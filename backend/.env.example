# Observação:
# Durante os testes, a chave fornecida pela Levva retornou a mensagem:
# "No endpoints available matching your guardrail restrictions and data policy".
# Para permitir a avaliação completa da aplicação, foi utilizada uma chave própria.

# Chave da API do OpenRouter (obrigatória para o chat com LLM)
OPENROUTER_API_KEY=sua_chave_aqui

# Modelo a usar no OpenRouter (padrão: gratuito)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Origens permitidas pelo CORS (frontend)
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost","http://127.0.0.1","http://localhost:3000"]
